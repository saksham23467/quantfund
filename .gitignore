# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.python-version

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store

# Data & experiment artifacts (keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/normalized/*
!data/normalized/.gitkeep
data/datasets/*
!data/datasets/.gitkeep
data/development/*
!data/development/.gitkeep
data/live_recordings/*
!data/live_recordings/.gitkeep
data/activations/*
!data/activations/.gitkeep
data/research/*
!data/research/.gitkeep
experiments/*
!experiments/.gitkeep
reports/*
!reports/.gitkeep

# Large local data dumps (not part of the package)
CF-CA-equities-*.csv
*.csv
!data/**/.gitkeep

# Secrets
*.pem
*.key
credentials.json
secrets/
*.token
*access_token*
.request_token*
.zerodha*
