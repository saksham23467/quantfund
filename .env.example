# QuantFund environment template — copy to .env and fill locally.
# Never commit real secrets.

# Optional: override default data directories
# QUANTFUND_DATA_DIR=./data
# QUANTFUND_EXPERIMENTS_DIR=./experiments

# Initial research capital (INR). Not connected to live trading.
# QUANTFUND_INITIAL_CAPITAL=100000

# ---------------------------------------------------------------------------
# Zerodha (READ-ONLY historical / Phase 16A account reads)
# ---------------------------------------------------------------------------
# Never commit real values. Never put secrets in reports or fixtures.
# ZERODHA_API_KEY=your_api_key_here
# ZERODHA_API_SECRET=your_api_secret_here
# ZERODHA_ACCESS_TOKEN=   # obtained via: make zerodha-login
# ZERODHA_ENV=production
#
# Kite app Redirect URL must be exactly:
#   http://127.0.0.1:8000/zerodha/callback
#
# Opt-in for REAL Zerodha historical API (still no order submission):
# QUANTFUND_ALLOW_ZERODHA_HISTORICAL=1
#
# Then run:
#   make zerodha-login
#   make zerodha-auth-check
#   make zerodha-real-validation
#
# Live trading remains DISABLED unless separate explicit enablement flows are used.
# LIVE_TRADING=false

# ---------------------------------------------------------------------------
# EC2 execution (optional — Mac remains control plane)
# ---------------------------------------------------------------------------
# Set these on the Mac when deploying; never commit real hosts/keys/secrets.
# QUANTFUND_EC2_HOST=ec2-XX-XX-XX-XX.compute-1.amazonaws.com
# QUANTFUND_EC2_USER=ubuntu
# QUANTFUND_EC2_SSH_KEY=/path/to/key.pem
# QUANTFUND_EC2_DIR=~/quantfund
# QUANTFUND_EC2_SYNC_ENV=0
# QUANTFUND_EC2_SYNC_DATA=1
# QUANTFUND_EXPECTED_ZERODHA_IP=x.x.x.x
# On the EC2 instance itself:
# QUANTFUND_EXECUTION_ROLE=EC2

